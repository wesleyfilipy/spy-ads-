// ============================================================
// AdSpy Platform — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum AdStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum AdType {
  IMAGE
  VIDEO
  CAROUSEL
  TEXT
}

enum AdPlatform {
  FACEBOOK
  INSTAGRAM
  AUDIENCE_NETWORK
  MESSENGER
}

enum MiningStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum MiningJobType {
  FULL_CRAWL
  INCREMENTAL
  COUNTRY_TARGETED
  KEYWORD_TARGETED
  EXTENSION_SUBMIT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ============================================================
// USERS
// ============================================================

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String
  avatarUrl      String?
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false)
  emailToken     String?    @unique
  resetToken     String?    @unique
  resetTokenExp  DateTime?
  lastLoginAt    DateTime?
  dailySearches  Int        @default(0)
  searchResetAt  DateTime   @default(now())

  subscription   Subscription?
  refreshTokens  RefreshToken[]
  favorites      Favorite[]
  searchHistory  SearchHistory[]
  payments       Payment[]
  adminLogs      AdminLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?            @unique
  stripePriceId         String?
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  trialEnd              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  stripePaymentId   String?       @unique
  amount            Int
  currency          String        @default("usd")
  status            PaymentStatus @default(PENDING)
  description       String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("payments")
}

// ============================================================
// ADS
// ============================================================

model Ad {
  id               String      @id @default(cuid())
  facebookAdId     String      @unique
  pageId           String?
  pageName         String?
  pageUrl          String?
  domain           String?
  status           AdStatus    @default(UNKNOWN)
  platforms        AdPlatform[]
  isScaled         Boolean     @default(false)
  isDuplicate      Boolean     @default(false)
  duplicateGroupId String?
  duplicateScore   Int?
  pHashValue       String?
  niche            String?
  startDate        DateTime?
  endDate          DateTime?
  impressionsLower Int?
  impressionsUpper Int?
  spendLower       Int?
  spendUpper       Int?
  currency         String?
  rawData          Json?

  creatives        Creative[]
  adCountries      AdCountry[]
  adLanguages      AdLanguage[]
  favorites        Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facebookAdId])
  @@index([domain])
  @@index([pageName])
  @@index([status])
  @@index([isScaled])
  @@index([isDuplicate])
  @@index([duplicateGroupId])
  @@index([createdAt])
  @@map("ads")
}

model Creative {
  id           String   @id @default(cuid())
  adId         String
  ad           Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  type         AdType   @default(IMAGE)
  mediaUrl     String?
  s3Key        String?
  thumbnailUrl String?
  thumbnailS3  String?
  headline     String?
  body         String?  @db.Text
  description  String?
  callToAction String?
  linkUrl      String?
  displayUrl   String?
  pHashValue   String?
  processed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adId])
  @@index([type])
  @@index([callToAction])
  @@map("creatives")
}

// ============================================================
// REFERENCE TABLES
// ============================================================

model Country {
  code String @id
  name String
  ads  AdCountry[]

  @@map("countries")
}

model AdCountry {
  adId        String
  countryCode String
  ad          Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)
  country     Country @relation(fields: [countryCode], references: [code])

  @@id([adId, countryCode])
  @@map("ad_countries")
}

model Language {
  code String @id
  name String
  ads  AdLanguage[]

  @@map("languages")
}

model AdLanguage {
  adId         String
  languageCode String
  ad           Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  language     Language @relation(fields: [languageCode], references: [code])

  @@id([adId, languageCode])
  @@map("ad_languages")
}

model Domain {
  id          String   @id @default(cuid())
  domain      String   @unique
  adsCount    Int      @default(0)
  activeAds   Int      @default(0)
  scaledAds   Int      @default(0)
  niche       String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([domain])
  @@map("domains")
}

// ============================================================
// USER INTERACTIONS
// ============================================================

model Favorite {
  id     String @id @default(cuid())
  userId String
  adId   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad     Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
  note   String?

  createdAt DateTime @default(now())

  @@unique([userId, adId])
  @@index([userId])
  @@map("favorites")
}

model SearchHistory {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  query   String
  filters Json?
  results Int    @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("search_history")
}

// ============================================================
// MINING
// ============================================================

model MiningLog {
  id            String        @id @default(cuid())
  type          MiningJobType
  status        MiningStatus  @default(PENDING)
  progress      Int           @default(0)
  totalAds      Int           @default(0)
  processedAds  Int           @default(0)
  newAds        Int           @default(0)
  updatedAds    Int           @default(0)
  errors        Int           @default(0)
  metadata      Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mining_logs")
}

// ============================================================
// ADMIN
// ============================================================

model AdminLog {
  id         String  @id @default(cuid())
  adminId    String
  admin      User    @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_logs")
}
