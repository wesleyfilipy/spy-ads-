# ============================================================
# ADSPY PLATFORM — ENVIRONMENT VARIABLES
# ============================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/adspy?schema=public"

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AWS S3 / Cloudflare R2 ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=adspy-creatives
AWS_REGION=us-east-1
# For Cloudflare R2, set the endpoint:
# AWS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Meta / Facebook ---
FACEBOOK_ADS_LIBRARY_BASE_URL=https://www.facebook.com/ads/library
META_API_ACCESS_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# --- Next.js public ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=changeme

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Mining ---
MINING_INTERVAL_MS=300000
MINING_BATCH_SIZE=50
MINING_CONCURRENCY=5
